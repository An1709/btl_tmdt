# Server
NODE_ENV=production
PORT=5001
CLIENT_URL=https://your-vercel-frontend-url.vercel.app

# MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database

# JWT
JWT_SECRET=your_jwt_secret

# Email delivery
# Gmail requires 2-Step Verification and a Google App Password.
EMAIL_SERVICE=gmail
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_google_app_password
FROM_EMAIL=your_email@gmail.com
FROM_NAME=PetMart
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FAMILY=4

# Cloudinary image storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# VNPay
VNP_TMN_CODE=your_vnpay_tmn_code
VNP_HASH_SECRET=your_vnpay_hash_secret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=https://your-render-backend-url.onrender.com/api/payment/vnpay_return
VNP_IPN_URL=https://your-render-backend-url.onrender.com/api/payment/vnpay_ipn
VNP_API=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# Pet Vision
PET_VISION_ENABLED=true
PET_VISION_PYTHON_BIN=python
# For Render with Root Directory = Backend, keep paths relative to Backend.
# If Render logs show python is unavailable, try PET_VISION_PYTHON_BIN=python3.
PET_VISION_MODEL_PATH=ml/models/pet_breed_model.keras
PET_VISION_LABELS_PATH=ml/labels.json
PET_VISION_UPLOAD_DIR=uploads/pet-vision/tmp
PET_VISION_KEEP_UPLOADS=false
PET_VISION_CONFIDENCE_THRESHOLD=0.55
PET_VISION_TIMEOUT_MS=120000
