# Server
PORT=5001
NODE_ENV=production
CLIENT_URL=https://your-frontend-domain.com

# MongoDB Atlas
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/DbTMDT

# JWT
ACCESS_TOKEN_SECRET=replace_with_strong_secret
ACCESS_TOKEN_EXPIRE=15m
REFRESH_TOKEN_EXPIRE=7d

# Email delivery
# Gmail requires 2-Step Verification and a Google App Password.
EMAIL_SERVICE=gmail
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_google_app_password
FROM_EMAIL=your_email@gmail.com
FROM_NAME=PetMart

# Cloudinary image storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# VNPay
VNP_TMN_CODE=your_vnpay_tmn_code
VNP_HASH_SECRET=your_vnpay_hash_secret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=https://your-backend-domain.com/api/payment/vnpay_return
VNP_IPN_URL=https://your-backend-domain.com/api/payment/vnpay_ipn

# Pet Vision
PET_VISION_ENABLED=true
PET_VISION_PYTHON_BIN=python
PET_VISION_MODEL_PATH=Backend/ml/models/pet_breed_model.keras
PET_VISION_LABELS_PATH=Backend/ml/labels.json
PET_VISION_UPLOAD_DIR=uploads/pet-vision/tmp
PET_VISION_KEEP_UPLOADS=false
PET_VISION_CONFIDENCE_THRESHOLD=0.55
