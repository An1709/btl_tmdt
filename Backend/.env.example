# Server
PORT=5001
CLIENT_URL=http://localhost:5173

# MongoDB
MONGODB_URL=mongodb://localhost:27017/your_database_name

# JWT
ACCESS_TOKEN_SECRET=replace_with_a_strong_access_token_secret
ACCESS_TOKEN_EXPIRE=30m
REFRESH_TOKEN_EXPIRE=14d

# Email delivery for OTP and account verification.
# For Gmail, enable 2-Step Verification on the Google account, then create an App Password.
# Use the 16-character App Password here, not your normal Gmail password.
EMAIL_SERVICE=gmail
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_16_character_google_app_password
FROM_EMAIL=your_email@gmail.com
FROM_NAME=PetShop Support

# VNPay placeholders
VNP_TMN_CODE=your_vnpay_tmn_code
VNP_HASH_SECRET=your_vnpay_hash_secret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:5001/api/payment/vnpay-return
VNP_IPN_URL=http://localhost:5001/api/payment/vnpay-ipn

# Optional integrations
OPENAI_API_KEY=your_openai_api_key
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY_ID=your_firebase_private_key_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
